# Plantilla del entorno de DEPLOY (Render).
# OJO: en Render no se sube ningún archivo .env. Estos valores se cargan
# como Environment Variables del servicio (o via el grupo `cinesfera`
# del Blueprint). Este archivo es solo la referencia de qué setear.

ENVIRONMENT=production

# URL pública del servicio en Render.
API_URL=https://cinesfera.onrender.com

# Orígenes del frontend que pueden llamar a esta API.
CORS_ORIGINS=https://cinesfera-three.vercel.app

# Base de datos (los mismos valores de Supabase que usás en local).
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
