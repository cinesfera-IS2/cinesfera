# Plantilla del entorno de DEPLOY (Render).
# OJO: en Render no se sube ningún archivo .env. Estos valores se cargan
# como Environment Variables del servicio (o via el grupo `cinesfera`
# del Blueprint). Este archivo es solo la referencia de qué setear.

ENVIRONMENT=production

# URL pública del servicio en Render.
API_URL=https://cinesfera.onrender.com

# Orígenes del frontend que pueden llamar a esta API.
CORS_ORIGINS=https://cinesfera-three.vercel.app

# Base de datos (los mismos valores de Supabase que usás en local).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Token de lectura (Bearer) de The Movie Database.
TMDB_ACCESS_TOKEN=

# Firma de los tokens de sesión. Usá un valor largo y aleatorio, distinto al local.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Bootstrap único del primer administrador. Luego puede crear otros desde el panel.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_NOMBRE=Administrador
ADMIN_INICIAL_APELLIDO=Cinesfera

LIMITE_REPORTES_DIARIOS=20
