# Plantilla para desarrollo LOCAL.
# Copiala a `.env` y completá los valores de la base:
#   cp .env.example .env

ENVIRONMENT=local
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opción A: cadena de conexión completa (la que te da Supabase).
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# Opción B: piezas sueltas (si DATABASE_URL está vacía se usan estas).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Token de lectura (Bearer) de The Movie Database.
TMDB_ACCESS_TOKEN=
TMDB_FORCE_IPV4=true


JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Safari no guarda cookies Secure en http://localhost. En producción
# la configuración no permite desactivarlo.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Se usan una sola vez, cuando la base todavía no tiene ningún administrador.
# La contraseña debe tener al menos 12 caracteres y se guarda únicamente como hash.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_NOMBRE=Administrador
ADMIN_INICIAL_APELLIDO=Cinesfera

LIMITE_REPORTES_DIARIOS=20
